{
 "uid": "library-hub",
 "title": "Smart Library Analytics Hub",
 "tags": [
  "library"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-2y",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Transactions in range",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT count(*) AS transactions FROM fact_borrowing WHERE issue_ts BETWEEN $__timeFrom() AND $__timeTo()"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Active members",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT count(DISTINCT member_id) AS members FROM fact_borrowing WHERE issue_ts BETWEEN $__timeFrom() AND $__timeTo() AND NOT member_missing"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Overdue loans %",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE status='OVERDUE')/greatest(count(*),1),2) AS overdue FROM fact_borrowing WHERE issue_ts BETWEEN $__timeFrom() AND $__timeTo()"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Streamed events (live)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT count(*) AS streamed FROM fact_borrowing WHERE ingest_mode='stream'"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "barchart",
   "title": "Most Borrowed Books (top 10)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT b.title AS book, count(*) AS borrows FROM fact_borrowing f JOIN dim_books b USING (book_id) WHERE f.issue_ts BETWEEN $__timeFrom() AND $__timeTo() GROUP BY b.title ORDER BY borrows DESC LIMIT 10"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "xField": "book",
    "legend": {
     "showLegend": false
    },
    "showValue": "auto"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Membership Growth",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT month::timestamp AS time, cumulative_members AS \"Total members\", new_members AS \"New members\" FROM analytics_membership_monthly WHERE $__timeFilter(month) ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "New members"
      },
      "properties": [
       {
        "id": "custom.drawStyle",
        "value": "bars"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Daily Transactions",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "library-pg"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "library-pg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_trunc('day', issue_ts) AS time, count(*) AS transactions FROM fact_borrowing WHERE issue_ts BETWEEN $__timeFrom() AND $__timeTo() GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}